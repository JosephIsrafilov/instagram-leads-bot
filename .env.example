# Values are placeholders. Never commit real tokens to GitHub.
META_APP_SECRET=replace_me
META_VERIFY_TOKEN=choose_a_long_random_string
IG_ACCOUNTS_JSON={"123456789":{"name":"Basic Academy","access_token":"IG_ACCESS_TOKEN_BASIC"},"987654321":{"name":"Affidavit","access_token":"IG_ACCESS_TOKEN_AFFIDAVIT"}}
META_API_VERSION=v26.0

# --- runtime ---
DATABASE_PATH=./leads.sqlite3
# api = real Instagram Graph API, console = only log messages (local dev)
IG_SEND_MODE=api
# background outbox worker: keep 1 in production, 0 in tests
WORKER_ENABLED=1
WORKER_POLL_INTERVAL=2.0
OUTBOX_MAX_ATTEMPTS=6
META_REQUEST_TIMEOUT=12
BOT_MAX_HINTS=3
LOG_LEVEL=INFO

# --- admin panel (/admin, /admin/leads.csv) ---
# leave ADMIN_PASSWORD empty to disable the panel; min 8 characters when set
ADMIN_USER=admin
ADMIN_PASSWORD=
